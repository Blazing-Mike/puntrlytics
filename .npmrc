# Overrides the user-level `allow-scripts` value (e.g. in ~/.npmrc). npm 11.17
# misreads that value as a CLI flag and rejects project-scoped installs with
# EALLOWSCRIPTS — and `npm run` even propagates it into child installs via
# env vars. Script approvals for this repo live in package.json's
# `allowScripts` fields instead, which is the documented location.
allow-scripts=
